# Reglas R8 específicas de Fluilet. AGP combina todos los archivos de src/main/keepRules.

# Gson: los DTOs se (de)serializan por reflexión y dependen de @SerializedName.
-keepattributes Signature, *Annotation*, EnclosingMethod, InnerClasses
-keep class com.fluilet.app.data.remote.dto.** { *; }

# Retrofit: conserva los métodos anotados de las interfaces de servicio.
-keepclassmembers,allowshrinking,allowobfuscation interface * {
    @retrofit2.http.* <methods>;
}
-dontwarn retrofit2.KotlinExtensions
-dontwarn retrofit2.KotlinExtensions$*

# OkHttp / Conscrypt: proveedores opcionales que pueden no estar presentes.
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**
-dontwarn org.conscrypt.**
-dontwarn okhttp3.internal.platform.**
